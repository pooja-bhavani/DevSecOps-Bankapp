script: |
  cd ~/bankapp

  cat > .env <<EOF
MYSQL_ROOT_PASSWORD=Test@123
MYSQL_DATABASE=bankappdb
MYSQL_USER=root
MYSQL_PASSWORD=Test@123
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bankappdb
DB_USER=root
DB_PASSWORD=Test@123
OLLAMA_URL=http://${{ secrets.OLLAMA_EC2_HOST }}:11434
APP_PORT=8080
DOCKERHUB_USERNAME=${{ secrets.DOCKERHUB_USERNAME }}
DOCKERHUB_PASSWORD=${{ secrets.DOCKERHUB_TOKEN }}
IMAGE_TAG=latest
EOF

  docker login -u ${{ secrets.DOCKERHUB_USERNAME }} -p ${{ secrets.DOCKERHUB_TOKEN }}

  docker compose --env-file .env -f docker-compose-bankapp.yml down || true
  docker compose --env-file .env -f docker-compose-bankapp.yml pull
  docker compose --env-file .env -f docker-compose-bankapp.yml up -d
