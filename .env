# Created .env from GitHub secrets
echo "DB_HOST=mysql" > .env
echo "DB_PORT=3306" >> .env
echo "DB_NAME=bankappdb" >> .env
echo "DB_USER=root" >> .env
echo "DB_PASSWORD=Test@123" >> .env
echo "OLLAMA_URL=http://${{ secrets.OLLAMA_EC2_HOST }}:11434" >> .env
echo "APP_PORT=8080" >> .env
echo "DOCKERHUB_USERNAME=${{ secrets.DOCKERHUB_USERNAME }}" >> .env
echo "DOCKERHUB_PASSWORD=${{ secrets.DOCKERHUB_TOKEN }}" >> .env
echo "IMAGE_TAG=latest" >> .env
